# DEVZOOP Blog Environment Configuration
# Copy this file to .env and configure your database credentials.

DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=devzoop_blog
DB_USER=root
DB_PASS=
DB_CHARSET=utf8mb4

APP_ENV=development
APP_DEBUG=true
APP_URL=http://localhost/portfolio
APP_SECRET=change_this_to_a_random_32_character_secret_key

# Upload limits
MAX_UPLOAD_SIZE=5242880
ALLOWED_IMAGE_TYPES=jpg,jpeg,png,webp
